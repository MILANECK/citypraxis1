# Copy to .env only for local development. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=website-media
APP_ORIGIN=http://127.0.0.1:3000
PORT=3000

# Digital reception: all keys are server-only. Replace with the client's project later.
CHAT_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHAT_AI_DAILY_LIMIT=200
# Optional stable random secret (otherwise Supabase's server secret is used).
CHAT_SESSION_SECRET=
# Only enable behind a known proxy that appends the real connecting IP.
TRUST_PROXY_HOPS=0
# Email delivery for all forms and chat; includes the submitted details.
# The CHAT_NOTIFY names apply to every source. See docs/digital-reception.md.
RESEND_API_KEY=
CHAT_NOTIFY_FROM=
CHAT_NOTIFY_TO=
